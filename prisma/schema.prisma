generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

enum StoryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  AUDIO
}

enum NotificationType {
  NEW_STORY
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)

  sessions     Session[]

  storiesCreated Story[]      @relation("StoriesCreated")
  storiesUpdated Story[]      @relation("StoriesUpdated")
  mediaCreated   MediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime

  user      AdminUser @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@index([userId])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarUrl    String?
  isActive     Boolean   @default(true)

  sessions     UserSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSession {
  id        String   @id
  userId    String
  expiresAt DateTime

  user      User @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@index([userId])
}

model StoryCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?
  icon        String?
  sortOrder   Int     @default(0)

  stories Story[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model MediaAsset {
  id        String    @id @default(uuid())
  type      MediaType
  url       String
  bucket    String?
  objectKey String?
  sizeBytes BigInt?
  mimeType  String?

  createdByAdminId String?
  createdByAdmin   AdminUser? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  coverForStories Story[] @relation("CoverAsset")
  audioForStories Story[] @relation("AudioAsset")

  createdAt DateTime @default(now())

  @@index([type])
}

model Story {
  id               String  @id @default(uuid())
  title            String
  slug             String  @unique
  shortDescription String
  body             String
  ageRangeMin      Int?
  ageRangeMax      Int?

  status      StoryStatus @default(DRAFT)
  isFeatured  Boolean     @default(false)
  publishedAt DateTime?

  categoryId   String?
  category     StoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  coverImageId String?
  coverImage   MediaAsset?    @relation("CoverAsset", fields: [coverImageId], references: [id], onDelete: SetNull)

  audioId      String?
  audio        MediaAsset?    @relation("AudioAsset", fields: [audioId], references: [id], onDelete: SetNull)

  createdByAdminId String
  createdByAdmin   AdminUser  @relation("StoriesCreated", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  updatedByAdminId String?
  updatedByAdmin   AdminUser? @relation("StoriesUpdated", fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  notificationLogs NotificationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([ageRangeMin, ageRangeMax])
}

model NotificationLog {
  id      String @id @default(uuid())
  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  type   NotificationType
  status NotificationStatus @default(PENDING)

  externalId   String?
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([storyId])
  @@index([status])
}
